; Trivia Arena: The Grand Stage — Godot 4 projesi
config_version=5

[application]

config/name="Trivia Arena: The Grand Stage"
config/description="Fizikle beslenen kaotik bir parti bilgi yarışması."
config/version="0.6.0-beta"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
config/windows_native_icon="res://icon.ico"
boot_splash/bg_color=Color(0.03, 0.015, 0.02, 1)
boot_splash/show_image=false

[autoload]

ErrorReporter="*res://scripts/core/error_reporter.gd"
I18n="*res://scripts/core/i18n.gd"
Profile="*res://scripts/core/profile.gd"
Questions="*res://scripts/core/questions.gd"
Sfx="*res://scripts/core/sfx.gd"
Music="*res://scripts/core/music.gd"
Narrator="*res://scripts/core/narrator.gd"
SteamService="*res://scripts/core/steam_service.gd"

[debug]

file_logging/enable_file_logging=true
file_logging/max_log_files=6

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

common/snap_controls_to_pixels=true

[input_devices]

pointing/emulate_touch_from_mouse=false

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="forward_plus"
rendering_device/fallback_to_vulkan=true
rendering_device/fallback_to_d3d12=true
rendering_device/fallback_to_opengl3=true
anti_aliasing/quality/msaa_3d=2
environment/volumetric_fog/volume_size=96
environment/volumetric_fog/volume_depth=96
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=2
